#!/bin/bash
# postinst - dpkg safe

set -u   # set -e YOK!

BG_URI="file:///usr/share/images/duvar.svg"

mkdir -p /etc/dconf/db/local.d
mkdir -p /etc/dconf/db/local.d/locks
mkdir -p /etc/dconf/profile

DESKTOP=""

if command -v cinnamon-session >/dev/null 2>&1; then
    DESKTOP="cinnamon"
elif command -v gnome-shell >/dev/null 2>&1; then
    DESKTOP="gnome"
fi

echo "🔍 Masaüstü tespiti: ${DESKTOP:-bulunamadı}"

if [ "$DESKTOP" = "cinnamon" ]; then

    tee /etc/dconf/db/local.d/desktop-background > /dev/null <<EOL
[org/cinnamon/desktop/background]
#picture-uri='$BG_URI'
picture-options='zoom'
EOL

    tee /etc/dconf/db/local.d/locks/desktop-background-lock > /dev/null <<EOL
/org/cinnamon/desktop/background/picture-uri
/org/cinnamon/desktop/background/picture-options
EOL

elif [ "$DESKTOP" = "gnome" ]; then

    tee /etc/dconf/db/local.d/desktop-background > /dev/null <<EOL
[org/gnome/desktop/background]
#picture-uri='$BG_URI'
picture-options='zoom'

[org/gnome/desktop/lockdown]
disable-background=true
EOL

    tee /etc/dconf/db/local.d/locks/desktop-background-lock > /dev/null <<EOL
/org/gnome/desktop/background/picture-uri
/org/gnome/desktop/background/picture-options
/org/gnome/desktop/lockdown/disable-background
EOL

else
    echo "⚠️ Cinnamon veya GNOME bulunamadı, atlanıyor"
    exit 0   # ⬅⬅⬅ KRİTİK
fi

tee /etc/dconf/profile/user > /dev/null <<EOL
user-db:user
system-db:local
EOL

dconf update

exit 0

